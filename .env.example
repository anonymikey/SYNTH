# ---------- AI provider: OpenRouter (default, recommended) ----------
# Create a free key at openrouter.ai/keys. SYNTH works out of the box with just this.
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
# Optional: pin a model that is tried first, e.g. a ":free" id from openrouter.ai/models
DEFAULT_MODEL=

# ---------- Optional second provider: SPARK gateway (FreeLLMAPI) ----------
# Disabled by default. SYNTH runs fine without it; you can turn it on later.
# FreeLLMAPI is self-hosted (github.com/tashfeenahmed/freellmapi). It cannot run on Vercel itself.
ENABLE_SPARK=false
SPARK_BASE_URL=
SPARK_API_KEY=
# Optional gateway profiles you create in its dashboard (e.g. auto:vision, auto:coding)
SPARK_VISION_MODEL=
SPARK_CODE_MODEL=
# Which provider is tried first: openrouter,spark (default) or spark,openrouter.
# If one fails or is slow, SYNTH silently moves to the next. A provider that is off or misconfigured is skipped.
PROVIDER_ORDER=openrouter,spark
# Optional shortcut that overrides ENABLE_SPARK and PROVIDER_ORDER: disabled | fallback | primary
# disabled = OpenRouter only, fallback = OpenRouter then SPARK, primary = SPARK then OpenRouter
GATEWAY_MODE=

# ---------- Learning + admin ----------
ADMIN_PASSWORD=            # required for /admin (use a long random string)
CRON_SECRET=               # required for the daily learning job (any long random string)
UPSTASH_REDIS_REST_URL=    # storage: add Upstash Redis from the Vercel Marketplace
UPSTASH_REDIS_REST_TOKEN=
AUTO_APPROVE=false         # true = lessons SYNTH writes itself go live without your review
AGENT_KEYS=                # other agents that may push lessons: name:key,name2:key2
AGENT_FEEDS=               # URLs of other agents' lesson feeds (JSON), comma-separated
