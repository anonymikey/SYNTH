# Any OpenAI-compatible provider. Defaults to OpenRouter (free models end in ":free").
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
# Optional: model preselected in the picker, e.g. a ":free" id from openrouter.ai/models
DEFAULT_MODEL=

# --- Learning + admin ---
ADMIN_PASSWORD=            # required for /admin (use a long random string)
CRON_SECRET=               # required for the daily learning job (any long random string)
UPSTASH_REDIS_REST_URL=    # storage: add Upstash Redis from the Vercel Marketplace
UPSTASH_REDIS_REST_TOKEN=
AUTO_APPROVE=false         # true = lessons SYNTH writes itself go live without your review
AGENT_KEYS=                # other agents that may push lessons: name:key,name2:key2
AGENT_FEEDS=               # URLs of other agents' lesson feeds (JSON), comma-separated

# --- SYNTHSPARK gateway (optional; without it SYNTH uses OpenRouter free models only) ---
# Your self-hosted FreeLLMAPI server (not Vercel). With or without the trailing /v1.
SPARK_BASE_URL=
# The unified key from the FreeLLMAPI dashboard (Keys page), starts with freellmapi-
SPARK_API_KEY=
# Optional: named routing profiles you create in the gateway dashboard, used as the first route.
# SPARK_VISION_MODEL=auto:vision    (profile containing vision-capable models, for SYNTH ASSISTANT)
# SPARK_CODE_MODEL=auto:coding      (profile containing code/reasoning models, for SYNTHCODE)
SPARK_VISION_MODEL=
SPARK_CODE_MODEL=
