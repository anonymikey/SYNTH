# ---------- AI provider: OpenRouter (default, recommended) ----------
# Create a free key at openrouter.ai/keys. SYNTH works out of the box with just this.
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
# Optional: pin a model that is tried first, e.g. a ":free" id from openrouter.ai/models
DEFAULT_MODEL=

# ---------- Optional second provider: SPARK gateway (FreeLLMAPI) ----------
# Disabled by default. SYNTH runs fine without it; you can turn it on later.
# FreeLLMAPI is self-hosted (github.com/tashfeenahmed/freellmapi). It cannot run on Vercel itself.
ENABLE_SPARK=false
SPARK_BASE_URL=
SPARK_API_KEY=
# Optional gateway profiles you create in its dashboard (e.g. auto:vision, auto:coding)
SPARK_VISION_MODEL=
SPARK_CODE_MODEL=
# ---------- Optional third provider: Cloudflare Workers AI ----------
# Disabled by default. Use only Cloudflare Workers Free if you want to avoid paid usage.
# Free allocation is limited to 10,000 Neurons per day; requests fail after it is exhausted.
# Cloudflare's 1M-context models are paid-only and are deliberately not selected by SYNTH.
ENABLE_CLOUDFLARE=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=       # keep server-side; grant only the Workers AI permission needed

# ---------- Optional fourth provider: UnoRouter free-model text fallback ----------
# Disabled by default. API key stays server-side. Only provider/model IDs ending in :free are accepted;
# SYNTH conservatively allows one request per model per minute across all workspace users. Image tasks and Learning Studio analysis skip this provider.
ENABLE_UNOROUTER=false
UNOROUTER_API_KEY=
# Optional comma-separated free-only model IDs. Defaults are two catalog IDs; every ID must end exactly in :free.
UNOROUTER_FREE_MODELS=deepseek/deepseek-v4.1-flash-1017:free,openai/gpt-oss-120b:free

# Which provider is tried first: openrouter,spark,cloudflare,unorouter (default). For example:
# PROVIDER_ORDER=cloudflare,openrouter,spark,unorouter
# If one fails or is slow, SYNTH silently moves to the next. A provider that is off or misconfigured is skipped.
PROVIDER_ORDER=openrouter,spark,cloudflare,unorouter
# Optional legacy shortcut that overrides ENABLE_SPARK and PROVIDER_ORDER: disabled | fallback | primary
# disabled = SPARK off, fallback = SPARK enabled in default order, primary = SPARK first
GATEWAY_MODE=

# ---------- Learning + admin ----------
ADMIN_PASSWORD=            # required for /admin (use a long random string)
CRON_SECRET=               # required for the daily learning job (any long random string)
UPSTASH_REDIS_REST_URL=    # storage: add Upstash Redis from the Vercel Marketplace
UPSTASH_REDIS_REST_TOKEN=
AUTO_APPROVE=false         # true = lessons SYNTH writes itself go live without your review
AGENT_KEYS=                # other agents that may push lessons: name:key,name2:key2
AGENT_FEEDS=               # URLs of other agents' lesson feeds (JSON), comma-separated

# ---------- Agent tools (all free, no account needed) ----------
# SYNTH ASSISTANT and SYNTHCODE can call free tools: web search, page reader, Wikipedia, weather, currency, Hacker News,
# cdnjs, clock and calculator. Individual tools can be switched off in /admin without redeploying.
ENABLE_TOOLS=true
# Read a link the user pastes before answering (the page text is fetched through a free reader service)
TOOLS_AUTO_READ=true
# Optional free keys. They only raise rate limits; everything works without them.
TAVILY_API_KEY=
JINA_API_KEY=
